# Alpaca Trading System Configuration

# Alpaca API Configuration
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_TRADING_MODE=paper  # Options: paper, live

# Trading Configuration
MAX_POSITION_SIZE=1000
MAX_DAILY_TRADES=100
RISK_PER_TRADE=0.02
DEFAULT_POSITION_SIZE=12000  # Dollar amount to allocate per trade
MARKET_OPEN_BUFFER_MINUTES=5
MARKET_CLOSE_BUFFER_MINUTES=10
DEFAULT_TIME_IN_FORCE=DAY
USE_EXTENDED_HOURS=false

# External API Configuration (for prediction service)
API_BASE_URL=your_prediction_api_url_here
API_KEY=your_prediction_api_key_here

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=trading.log 